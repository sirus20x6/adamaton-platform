{
  "id": "search_linkup",
  "name": "LinkUp",
  "description": "LinkUp managed web-search API with standard/deep depth modes.",
  "version": "0.1.0",
  "category": "search",
  "capabilities": ["search.query", "search.fetch"],
  "command": ["/opt/dr-plugin-venv/bin/python", "-m", "dr_plugin_search_linkup"],
  "transport": "grpc-unix",
  "config_schema": {
    "type": "object",
    "properties": {
      "LINKUP_API_KEY": {
        "type": "string",
        "description": "API key for the LinkUp search service."
      },
      "LINKUP_BASE_URL": {
        "type": "string",
        "description": "Override the default https://api.linkup.so endpoint.",
        "default": "https://api.linkup.so"
      },
      "LINKUP_DEPTH": {
        "type": "string",
        "enum": ["standard", "deep"],
        "description": "Search depth; 'deep' is more expensive but broader.",
        "default": "standard"
      }
    },
    "required": ["LINKUP_API_KEY"]
  },
  "args_schema": {
    "type": "object",
    "properties": {}
  },
  "supervisor": {
    "idle_timeout_seconds": 600,
    "max_restart_per_min": 3
  }
}
