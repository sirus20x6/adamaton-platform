{
  "id": "search_openalex",
  "name": "OpenAlex",
  "description": "OpenAlex Works API adapter; uses the polite pool when a mailto is configured.",
  "version": "0.1.0",
  "category": "search",
  "capabilities": ["search.query", "search.fetch"],
  "command": ["/opt/dr-plugin-venv/bin/python", "-m", "dr_plugin_search_openalex"],
  "transport": "grpc-unix",
  "config_schema": {
    "type": "object",
    "properties": {
      "OPENALEX_MAILTO": {
        "type": "string",
        "description": "Contact email for OpenAlex's polite pool; defaults to sirus20x6@gmail.com."
      }
    },
    "required": []
  },
  "args_schema": {
    "type": "object",
    "properties": {}
  },
  "supervisor": {
    "idle_timeout_seconds": 600,
    "max_restart_per_min": 3
  }
}
