{
  "id": "search_tavily",
  "name": "Tavily",
  "description": "Tavily managed web-search API; LLM-cleaned content surfaced on abstract.",
  "version": "0.1.0",
  "category": "search",
  "capabilities": ["search.query", "search.fetch"],
  "command": ["/opt/dr-plugin-venv/bin/python", "-m", "dr_plugin_search_tavily"],
  "transport": "grpc-unix",
  "config_schema": {
    "type": "object",
    "properties": {
      "TAVILY_API_KEY": {
        "type": "string",
        "description": "API key for the Tavily search service."
      },
      "TAVILY_BASE_URL": {
        "type": "string",
        "description": "Override the default https://api.tavily.com endpoint.",
        "default": "https://api.tavily.com"
      }
    },
    "required": ["TAVILY_API_KEY"]
  },
  "args_schema": {
    "type": "object",
    "properties": {}
  },
  "supervisor": {
    "idle_timeout_seconds": 600,
    "max_restart_per_min": 3
  }
}
