{
  "id": "search_logseq",
  "name": "Logseq Graph",
  "description": "Search a Logseq graph directory (markdown pages and journal entries).",
  "version": "0.1.0",
  "category": "search",
  "capabilities": ["search.query"],
  "command": ["/opt/dr-plugin-venv/bin/python", "-m", "dr_plugin_search_logseq"],
  "transport": "grpc-unix",
  "config_schema": {
    "type": "object",
    "properties": {
      "graph_path": {
        "type": "string",
        "description": "Absolute path to the Logseq graph root directory."
      },
      "include_journals": {
        "type": "boolean",
        "description": "Whether to include journal entries in search results.",
        "default": true
      }
    },
    "required": ["graph_path"]
  },
  "args_schema": {
    "type": "object",
    "properties": {}
  },
  "supervisor": {
    "idle_timeout_seconds": 600,
    "max_restart_per_min": 3
  }
}
