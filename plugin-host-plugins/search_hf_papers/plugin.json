{
  "id": "search_hf_papers",
  "name": "Hugging Face Papers",
  "description": "Engagement-curated daily index over arXiv; fetch() routes at arxiv.org/pdf so the trust pipeline sees source_tier=pdf.",
  "version": "0.1.0",
  "category": "search",
  "capabilities": ["search.query", "search.fetch"],
  "command": ["/opt/dr-plugin-venv/bin/python", "-m", "dr_plugin_search_hf_papers"],
  "transport": "grpc-unix",
  "config_schema": {
    "type": "object",
    "properties": {},
    "required": []
  },
  "args_schema": {
    "type": "object",
    "properties": {}
  },
  "supervisor": {
    "idle_timeout_seconds": 600,
    "max_restart_per_min": 3
  }
}
