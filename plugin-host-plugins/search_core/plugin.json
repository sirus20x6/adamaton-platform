{
  "id": "search_core",
  "name": "CORE",
  "description": "CORE — aggregator of open-access research papers (200M+).",
  "version": "0.1.0",
  "category": "search",
  "capabilities": ["search.query"],
  "command": ["/opt/dr-plugin-venv/bin/python", "-m", "dr_plugin_search_core"],
  "transport": "grpc-unix",
  "config_schema": {
    "type": "object",
    "properties": {
      "CORE_API_KEY": {
        "type": "string",
        "description": "Required CORE API key (env CORE_API_KEY). Sent as Bearer token."
      }
    },
    "required": ["CORE_API_KEY"]
  },
  "args_schema": {
    "type": "object",
    "properties": {}
  },
  "supervisor": {
    "idle_timeout_seconds": 600,
    "max_restart_per_min": 3
  }
}
