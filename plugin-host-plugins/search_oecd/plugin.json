{
  "id": "search_oecd",
  "name": "OECD iLibrary",
  "description": "OECD publication search via the iLibrary public search endpoint. Best-effort HTML scrape; may degrade if upstream markup changes.",
  "version": "0.1.0",
  "category": "search",
  "capabilities": ["search.query"],
  "command": ["/opt/dr-plugin-venv/bin/python", "-m", "dr_plugin_search_oecd"],
  "transport": "grpc-unix",
  "config_schema": {
    "type": "object",
    "properties": {},
    "required": []
  },
  "args_schema": {
    "type": "object",
    "properties": {}
  },
  "supervisor": {
    "idle_timeout_seconds": 600,
    "max_restart_per_min": 3
  }
}
