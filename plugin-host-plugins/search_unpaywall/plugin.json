{
  "id": "search_unpaywall",
  "name": "Unpaywall",
  "description": "Find legal open-access copies of scholarly papers by DOI or keyword.",
  "version": "0.1.0",
  "category": "search",
  "capabilities": ["search.query", "search.fetch"],
  "command": ["/opt/dr-plugin-venv/bin/python", "-m", "dr_plugin_search_unpaywall"],
  "transport": "grpc-unix",
  "config_schema": {
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "description": "Contact email required by the Unpaywall API; defaults to env UNPAYWALL_EMAIL."
      }
    },
    "required": ["email"]
  },
  "args_schema": {
    "type": "object",
    "properties": {}
  },
  "supervisor": {
    "idle_timeout_seconds": 600,
    "max_restart_per_min": 3
  }
}
