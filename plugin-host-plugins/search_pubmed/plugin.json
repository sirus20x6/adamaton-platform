{
  "id": "search_pubmed",
  "name": "PubMed",
  "description": "NCBI PubMed biomedical literature via E-utilities.",
  "version": "0.1.0",
  "category": "search",
  "capabilities": ["search.query"],
  "command": ["/opt/dr-plugin-venv/bin/python", "-m", "dr_plugin_search_pubmed"],
  "transport": "grpc-unix",
  "config_schema": {
    "type": "object",
    "properties": {
      "ncbi_api_key": {
        "type": "string",
        "description": "Optional NCBI API key (env NCBI_API_KEY). Raises rate limit from 3/s to 10/s."
      }
    },
    "required": []
  },
  "args_schema": {
    "type": "object",
    "properties": {}
  },
  "supervisor": {
    "idle_timeout_seconds": 600,
    "max_restart_per_min": 3
  }
}
