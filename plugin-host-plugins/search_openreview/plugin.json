{
  "id": "search_openreview",
  "name": "OpenReview",
  "description": "OpenReview v1 API adapter; surfaces NeurIPS / ICLR / COLM / TMLR submissions plus peer review threads.",
  "version": "0.1.0",
  "category": "search",
  "capabilities": ["search.query", "search.fetch"],
  "command": ["/opt/dr-plugin-venv/bin/python", "-m", "dr_plugin_search_openreview"],
  "transport": "grpc-unix",
  "config_schema": {
    "type": "object",
    "properties": {
      "OPENREVIEW_USERNAME": {
        "type": "string",
        "description": "Optional OpenReview username; lifts public-read rate limits."
      },
      "OPENREVIEW_PASSWORD": {
        "type": "string",
        "description": "Optional OpenReview password (paired with OPENREVIEW_USERNAME)."
      }
    },
    "required": []
  },
  "args_schema": {
    "type": "object",
    "properties": {}
  },
  "supervisor": {
    "idle_timeout_seconds": 600,
    "max_restart_per_min": 3
  }
}
